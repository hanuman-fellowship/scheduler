  "notes": [
    "Canonical roles in app: operations, manager, personnel. Guest is supported via Authsome::login('guest'). No 'user' role exists; use 'logged_in' as a condition instead.",
    "Guest access is only permitted where AppController.beforeFilter allows unauthenticated access (People.upload).",
    "'schedule_owner' derives from AppController.beforeFilter: Schedule.editable is true when current user (Authsome::get('id')) equals Session('Schedule.user_id') AND user has 'operations' role (app_controller.php:31-37).",
    "'request_mode' derives from AppController.redirectIfNotEditable: access allowed when Session('Schedule.request') == 2 regardless of role (app_controller.php:263-267).",
    "'manager_of_area' derives from AppController.redirectIfNotManager: user must manage the area id passed in to the action (app_controller.php:276-281).",
