{
  "name": "scheduler-api",
  "version": "1.0.0",
  "description": "Express API for Scheduler",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc && tsc-alias",
    "prestart": "npm run build",
    "start": "npx prisma migrate deploy && node dist/backend/src/server.js",
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon --watch src --watch ../shared/src -e ts,yaml --exec ts-node -r tsconfig-paths/register src/server.ts",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src/**/*.{ts,tsx,json,md}",
    "test": "jest",
    "test:watch": "jest --watch --verbose",
    "test:coverage": "jest --coverage",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "test:setup": "DATABASE_URL=\"${DATABASE_URL_TEST:-postgresql://scheduler_user:scheduler_password@localhost:5432/scheduler_test}\" npx prisma db push",
    "test:reset": "DATABASE_URL=\"${DATABASE_URL_TEST:-postgresql://scheduler_user:scheduler_password@localhost:5432/scheduler_test}\" npx prisma db push --force-reset",
    "check": "tsc --noEmit",
    "migrate": "npx prisma migrate dev",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "prisma": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.0",
    "express-async-handler": "^1.2.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.0",
    "tsc-alias": "^1.8.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
